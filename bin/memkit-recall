#!/bin/sh
# `memkit-recall --search "<terms>"` — the on-demand half of the recall hook,
# for an adopter whose memkit came from a plugin install.
#
# A distinct NAME rather than a second `memory-recall`, because plugin `bin/`
# ordering against a pip or nix install of the same package is undocumented.
# Two binaries called `memory-recall` resolving to differently-configured
# installs would search the wrong stores and say nothing about it — a wrong
# answer that looks exactly like a right one. Nothing here can collide.
#
# This is the command the hook's own truncation notice advertises on a plugin
# install, so what it searches and what the hook searches have to be the same
# thing by construction: same file, same config resolution, same interpreter.
# The notice does NOT come from the config's `search_cli` field on this
# channel — that value travels between channels and cannot know which one is
# reading it — so the hook emits this binary's name with the `--config <path>`
# it resolved, which is the form that still works from the agent's Bash tool,
# where none of the plugin's own environment is delivered.
#
# Unlike `memkit-hook`, exit codes MATTER here and are passed through. The
# caller is an agent deciding whether to go read something, and 0/1/2/3 are
# four different next moves — see the table in the README.
#
# This file adds the fifth. Everything below that ends the run before the
# search could start exits 4, not 2: 2 means "what you asked for is wrong" —
# your config, your corpus, your arguments — and an agent reading that retries
# with a different query against a machine that has no python on it. The one
# exception is the no-argument refusal, which genuinely IS a wrong invocation
# and stays 2.

set -u

# The name this wrapper answers to, for every message bin/lib/common.sh emits
# on its behalf. Declared before the library is sourced, because the shared
# messages sit beside per-wrapper exit codes and a message naming the wrong
# binary sends an agent to the wrong exit-code table.
MEMKIT_SELF=memkit-recall

# The plugin tree, from this file's own path. See bin/lib/common.sh.
_self=$0
case $_self in
    */*) : ;;
    *) _self=$(command -v -- "$_self" 2>/dev/null || printf '%s' "$_self") ;;
esac
MEMKIT_ROOT=$(cd "${_self%/*}/.." 2>/dev/null && pwd -P) || MEMKIT_ROOT=""

if [ -z "${MEMKIT_ROOT:-}" ] || [ ! -f "$MEMKIT_ROOT/bin/lib/common.sh" ]; then
    echo "memkit-recall: cannot locate the plugin tree from $0" >&2
    exit 4
fi

. "$MEMKIT_ROOT/bin/lib/common.sh"

# No arguments is not "search for nothing" — it is the hook's payload mode,
# where the file blocks on stdin waiting for a JSON payload that is never
# coming. An agent that ran this bare would hang until the harness killed it,
# with no output to explain why. Refuse instead, and name the one flag that
# does something.
if [ "$#" -eq 0 ]; then
    echo "memkit-recall: nothing to do — try: memkit-recall --search \"<terms>\"" >&2
    echo "(--dir PATH searches a directory instead of the configured stores)" >&2
    exit 2
fi

HOOK_FILE="$MEMKIT_ROOT/src/memkit/memory_prompt_recall.py"
if [ ! -f "$HOOK_FILE" ]; then
    echo "memkit-recall: the plugin payload is incomplete — no $HOOK_FILE" >&2
    exit 4
fi

CONFIG=$(memkit_resolve_config) || CONFIG=""
# Same hard override as the hook wrapper, in both directions, for the same
# reason: what a plugin install searches is decided by the install, not by
# whatever the launching shell exported. `--config PATH` on the command line
# still wins over this, which is how a person points one invocation somewhere
# else without changing what the hook serves.
if [ -n "$CONFIG" ]; then
    MEMKIT_CONFIG=$CONFIG
    export MEMKIT_CONFIG
else
    unset MEMKIT_CONFIG
fi

PY=$(memkit_resolve_interpreter "$CONFIG") || PY=""
if [ -z "$PY" ]; then
    memkit_no_interpreter_message "$CONFIG" >&2
    exit 4
fi

MEMKIT_PLUGIN=1
export MEMKIT_PLUGIN

exec "$PY" "$HOOK_FILE" "$@"
